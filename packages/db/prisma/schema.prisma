generator client {
  provider = "prisma-client"
  output = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  viewer
}

enum SourceProvider {
  relayhub
  github
}

enum DeliveryStatus {
  pending
  queued
  delivering
  retry_scheduled
  delivered
  failed
  cancelled
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships OrganizationMember[]
  twoFactorEnabled Boolean @default(false)
  twoFactor TwoFactor?
}

model TwoFactor {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String
  backupCodes String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
}

model Session {
  id String @id @default(uuid())
  token String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id String @id @default(uuid())
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id String @id @default(uuid())
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id String @id @default(uuid())
  key String @unique
  count Int
  lastRequest BigInt
}

model Organization {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  members OrganizationMember[]
  sources WebhookSource[]
  destinations WebhookDestination[]
  audit AuditLog[]
  apiKeys OrganizationApiKey[]
}

model OrganizationApiKey {
  id String @id @default(uuid())
  organizationId String
  name String
  digest String @unique
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model OrganizationMember {
  organizationId String
  userId String
  role Role
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  destinationEmailSubscriptions DestinationEmailSubscription[]

  @@id([organizationId, userId])
  @@index([userId])
}

model WebhookSource {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  provider SourceProvider @default(relayhub)
  secret String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  subscriptions Subscription[]
  events WebhookEvent[]
  ingressReceipts IngressReceipt[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}

model WebhookDestination {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  url String
  secret String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  subscriptions Subscription[]
  deliveries Delivery[]
  consecutiveFailures Int @default(0)
  failureStreakId String?
  lastHealthObservationAt DateTime?
  dailyStats DestinationDailyStat[]
  incidents DestinationIncident[]
  emailSubscriptions DestinationEmailSubscription[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}

model DestinationEmailSubscription {
  id String @id @default(uuid())
  destinationId String
  organizationId String
  userId String
  email String
  locale String
  verifiedAt DateTime?
  challengeExpiresAt DateTime?
  failedChecks Int @default(0)
  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  destination WebhookDestination @relation(fields: [destinationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  messages DestinationEmailMessage[]

  @@unique([destinationId, userId])
  @@index([organizationId, userId])
  @@index([challengeExpiresAt])
}

model DestinationEmailMessage {
  id BigInt @id @default(autoincrement())
  subscriptionId String
  eventKey String
  kind String
  destinationName String
  occurredAt DateTime
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  attempts Int @default(0)
  finishedAt DateTime?
  failed Boolean @default(false)
  subscription DestinationEmailSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventKey])
  @@index([finishedAt, nextAttemptAt])
}

model DestinationDailyStat {
  destinationId String
  organizationId String
  day DateTime @db.Date
  successCount Int @default(0)
  failureCount Int @default(0)
  responseDurationMs BigInt @default(0)
  responseCount Int @default(0)
  destination WebhookDestination @relation(fields: [destinationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([destinationId, day])
  @@index([organizationId, day])
  @@index([day])
}

model DestinationIncident {
  // The opening attempt's UUID survives raw delivery retention.
  id String @id
  destinationId String
  organizationId String
  openedAt DateTime
  openedOrder BigInt @default(autoincrement())
  resolvedAt DateTime?
  resolvedOrder BigInt?
  failureCount Int
  failureStreakId String?
  destination WebhookDestination @relation(fields: [destinationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // The migration also enforces one unresolved incident per destination.
  @@index([organizationId, resolvedAt, openedAt])
  @@index([organizationId, openedAt, openedOrder])
  @@index([organizationId, resolvedAt, resolvedOrder])
  @@index([destinationId, openedAt])
  @@index([resolvedAt])
}

model Subscription {
  organizationId String
  sourceId String
  destinationId String
  eventType String @default("")
  source WebhookSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  destination WebhookDestination @relation(fields: [destinationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([sourceId, destinationId, eventType])
  @@index([destinationId, organizationId])
}

model WebhookEvent {
  id String @id @default(uuid())
  organizationId String
  sourceId String
  source WebhookSource @relation(fields: [sourceId, organizationId], references: [id, organizationId])
  externalId String
  eventType String
  receivedAt DateTime @default(now())
  payloadSize Int
  payloadHash String
  payload String
  correlationId String
  deliveries Delivery[]

  @@unique([sourceId, externalId])
  @@unique([id, organizationId])
  @@index([organizationId, receivedAt, id])
  @@index([receivedAt])
}

model Delivery {
  id String @id @default(uuid())
  organizationId String
  eventId String
  destinationId String
  event WebhookEvent @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  destination WebhookDestination @relation(fields: [destinationId, organizationId], references: [id, organizationId])
  status DeliveryStatus @default(pending)
  generation Int @default(1)
  runAttempts Int @default(0)
  attemptCount Int @default(0)
  leaseToken String?
  leaseExpiresAt DateTime?
  lastStatus Int?
  durationMs Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  queuedAt DateTime?
  nextAt DateTime @default(now())
  finishedAt DateTime?
  attempts DeliveryAttempt[]
  outbox OutboxEntry?

  @@unique([eventId, destinationId])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([destinationId, organizationId])
  @@index([status, leaseExpiresAt])
}

model DeliveryAttempt {
  id String @id @default(uuid())
  deliveryId String
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  number Int
  startedAt DateTime @default(now())
  finishedAt DateTime?
  httpStatus Int?
  durationMs Int?
  outcome String @default("in_progress")
  retryAt DateTime?
  failureStreakId String?

  @@unique([deliveryId, number])
  @@index([failureStreakId, deliveryId])
}

model OutboxEntry {
  deliveryId String @id
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  generation Int
  availableAt DateTime
  publishAfter DateTime

  @@index([publishAfter])
}

model AuditLog {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model RequestCounter {
  key String @id
  hits Int
  expiresAt DateTime

  @@index([expiresAt])
}

model RegistrationInvite {
  digest String @id
  expiresAt DateTime
  usedAt DateTime?

  @@index([expiresAt])
}

model IngressReceipt {
  sourceId String
  signature String
  externalId String
  expiresAt DateTime
  source WebhookSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sourceId, signature])
  @@index([expiresAt])
}
